{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/index.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  }
}
/* كود إجبار القوائم على التنسيق العربي الصحيح */
select {
  direction: rtl !important;
  text-align: right !important; /* إجبار النص على اليمين */
  appearance: none !important; /* حذف سهم المتصفح المعاند في اليمين */
  -webkit-appearance: none !important;
  
  /* رسم سهم جديد تماماً وتثبيته في جهة اليسار */
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23666' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
  background-repeat: no-repeat !important;
  background-position: left 0.75rem center !important; /* مكان السهم الجديد */
  background-size: 1.1em !important;
  
  /* إزاحة النص لكي لا يغطي السهم في اليسار */
  padding-left: 2.5rem !important;
  padding-right: 1rem !important;
}

/* التأكد من أن الخيارات داخل القائمة تتبع اليمين أيضاً */
select option {
  direction: rtl !important;
  text-align: right !important;
}